        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sélection est trop détaillée pour être tracée. Essayez une autre Tolérance, ou activez Pixels contigus."
          }
        }
      }
    },
    "The Photoshop file could not be read. It may be damaged or incomplete.": {
