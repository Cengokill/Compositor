    "Bake keeps the current masked appearance in the dependent layers’ pixels. Remove Links reveals their pixels. You can undo either choice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bake keeps the current masked appearance in the dependent layers’ pixels. Remove Links reveals their pixels. You can undo either choice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorporer conserve l’apparence masquée actuelle dans les pixels des calques dépendants. Supprimer les liens révèle leurs pixels. Les deux choix sont annulables."
          }
        }
      }
    },
